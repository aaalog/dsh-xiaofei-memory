{
  "name": "dsh-xiaofei-memory",
  "version": "0.1.0",
  "description": "Headless, async, self-evolving long-term memory engine for DeepSeek Harness (DSH). A dual-track 'digital hippocampus': pre-step retrieval injection, turn/end async capture, nightly metabolism, and adaptive evolution.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "agent-memory",
    "sqlite",
    "fts5"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node build.mjs",
    "build:client": "node build.mjs",
    "test": "node test-engine.mjs && node test-load.mjs && node test-console.mjs && node test-bridge.mjs && node build.mjs && node test-client.mjs && node test-dist.mjs"
  }
}
